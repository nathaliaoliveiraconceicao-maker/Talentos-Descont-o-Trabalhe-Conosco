{
  "name": "vagahub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VagaHub: plataforma SaaS multiempresa para recrutamento, triagem, relatórios e banco de talentos — todas as suas contratações em um só lugar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "seed": "tsx scripts/seedMockData.ts",
    "create-admin": "tsx scripts/createAdmin.ts",
    "create-superadmin": "tsx scripts/createSuperAdmin.ts",
    "migrate-descontao": "tsx scripts/migrateToTenant.ts",
    "link-existing-user": "tsx scripts/linkExistingUser.ts",
    "test:rules": "firebase emulators:exec --project demo-talentos-rules-test --only firestore,storage \"node tests/rules/runAll.mjs\""
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/readline-sync": "^1.4.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^12.6.0",
    "firebase-tools": "^15.24.0",
    "postcss": "^8.4.47",
    "readline-sync": "^1.4.10",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
