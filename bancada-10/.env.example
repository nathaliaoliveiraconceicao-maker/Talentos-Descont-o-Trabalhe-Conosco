# ==============================================================================
# Bancada 10 — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com as credenciais reais.
# NUNCA commite o ".env.local" (já está no .gitignore).
# ==============================================================================

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Bancada 10"

# --- Supabase ------------------------------------------------------------------
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — uso exclusivo em rotas server-side (API routes/admin).
# NUNCA exponha esta chave no client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago --------------------------------------------------------------
# https://www.mercadopago.com.br/developers/panel/app
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# Segredo usado para validar a assinatura dos webhooks do Mercado Pago
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Frete -----------------------------------------------------------------
# Preencher quando a transportadora/API de frete for definida
# (ex.: Melhor Envio, Correios, API própria do fornecedor).
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
SHIPPING_ORIGIN_ZIP_CODE=

# --- WhatsApp --------------------------------------------------------------
# Número oficial da loja, em formato internacional sem símbolos (ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics / Ads ---------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# --- Instagram (feed manual/API) ---------------------------------------------
# Preencher se/quando a integração oficial (Instagram Graph API) for configurada.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
