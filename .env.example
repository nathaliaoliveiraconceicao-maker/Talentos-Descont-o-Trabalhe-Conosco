# Configuração do Firebase (Web App)
# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase.
# Console: https://console.firebase.google.com/ > Configurações do projeto > Geral > Seus apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (Google Analytics para Firebase)
VITE_FIREBASE_MEASUREMENT_ID=

# Nome público da empresa (usado em textos e mensagens de WhatsApp)
VITE_COMPANY_NAME="Supermercado Descontão"

# Prazo padrão (em meses) de retenção de dados do banco de talentos, usado como valor inicial
VITE_DEFAULT_RETENTION_MONTHS=24
