# Configuração do Firebase (Web App)
# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase.
# Console: https://console.firebase.google.com/ > Configurações do projeto > Geral > Seus apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (Google Analytics para Firebase)
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (reCAPTCHA v3) — protege o Firestore/Storage contra
# bots e uso indevido da API fora do app. Crie a chave em:
# Console do Firebase > App Check > Apps > Web > reCAPTCHA v3.
# Sem essa variável, o app funciona normalmente mas SEM o App Check ativo.
VITE_RECAPTCHA_SITE_KEY=

# Opcional: token de depuração do App Check, apenas para desenvolvimento
# local (nunca defina isso em produção). Gerado automaticamente e impresso
# no console do navegador na primeira vez que rodar "npm run dev" sem uma
# site key válida; cadastre-o em Console do Firebase > App Check > Apps >
# Gerenciar tokens de depuração.
VITE_APPCHECK_DEBUG_TOKEN=
