rules_version = '2';

// Regras de segurança do Firebase Storage — Plataforma multi-tenant de Talentos
//
// Estrutura de arquivos:
//   tenants/{tenantId}/candidates/{candidateId}/resume/{fileName}
//   tenants/{tenantId}/branding/{fileName}
//
// Usa a integração nativa de Storage Rules com o Cloud Firestore
// (funções firestore.get()/firestore.exists()) para checar, por tenant, se
// quem está pedindo é um usuário ativo daquele cliente ou um superadmin da
// plataforma — sem isso, não seria possível impedir que um usuário do
// Cliente A baixasse currículos do Cliente B usando apenas Storage Rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/platformAdmins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid)).data.active == true;
    }

    function isActiveTenantMember(tenantId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.active == true;
    }

    function hasTenantAccess(tenantId) {
      return isSuperAdmin() || isActiveTenantMember(tenantId);
    }

    match /tenants/{tenantId}/candidates/{candidateId}/resume/{fileName} {
      // Candidatos (não autenticados) podem enviar o currículo no envio da
      // pré-candidatura, respeitando tipo e tamanho máximo do arquivo.
      allow create: if
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|image/jpeg|image/png'
        );
      // Só usuários do próprio tenant (ou superadmin) podem visualizar/baixar
      // ou remover — nunca de outro cliente.
      allow read, delete: if hasTenantAccess(tenantId);
      allow update: if false;
    }

    match /tenants/{tenantId}/branding/{fileName} {
      // A plataforma não usa mais logomarca de cliente em lugar nenhum — a
      // identidade visual exibida é sempre a da VagaHub, e cada empresa é
      // identificada só pelo nome em texto (tenant.name). Uploads novos
      // ficam desativados; arquivos já enviados por algum tenant antes desta
      // mudança são preservados (não excluídos automaticamente) e continuam
      // legíveis publicamente até serem removidos manualmente após validação
      // (ver README).
      allow read: if true;
      allow write: if false;
    }

    // Nega tudo o mais por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
