rules_version = '2';

// Regras de segurança do Firebase Storage — Talentos Descontão
//
// Somente administradores/RH possuem contas no Firebase Authentication
// (criadas via script/console — candidatos nunca se autenticam). Por isso,
// "request.auth != null" neste projeto equivale, na prática, a "é um
// usuário administrativo autenticado" (o papel admin/rh e o campo active
// são validados no Firestore, em /admins/{uid}, pelas regras do Firestore
// e pela lógica de autorização da aplicação).
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{fileName} {
      // Candidatos (não autenticados) podem enviar o currículo no envio da
      // pré-candidatura, respeitando tipo e tamanho máximo do arquivo.
      allow create: if
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|image/jpeg|image/png'
        );

      // Somente administradores autenticados podem visualizar ou remover currículos.
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Nega tudo o mais por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
